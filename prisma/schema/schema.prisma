generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId    String     @id
  firstName String
  lastName  String
  email     String     @unique
  notebooks Notebook[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("user")
}
