generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId    String     @id @default(uuid())
  firstName String
  lastName  String
  email     String
  password  String
  notebooks Notebook[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
  @@map("user")
}

model Notebook {
  notebookId String   @id @default(uuid())
  title      String
  userId     String
  user       User     @relation(fields: [userId], references: [userId])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("notebook")
}
